# Chicago Open311
CHICAGO_311_API_KEY=                                          # Optional; higher rate limits when set
CHICAGO_311_BASE_URL=https://311api.cityofchicago.org/open311/v2  # Open311 v2 endpoint
POLL_INTERVAL_SECONDS=60                                      # Seconds between API polls (do not go below 30)
SERVICE_CODES=4fd3055e7f3b34730000000b,4ffa9f2d6018277d4000000b  # Comma-separated Chicago 311 service codes to poll

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092                        # Kafka broker address(es)
KAFKA_RAW_TOPIC=civic.requests.raw                            # Topic for raw ingested service requests
KAFKA_DLQ_TOPIC=civic.requests.dlq                            # Dead-letter topic for failed classifications
KAFKA_CONSUMER_GROUP=urgency-classifier-group                 # Consumer group id for the classifier

# Anthropic Claude API (urgency classifier)
ANTHROPIC_API_KEY=                                            # Anthropic API key for the urgency classifier
ANTHROPIC_MODEL=claude-haiku-4-5-20251001                     # Claude model used for classification
LANGFUSE_FLUSH_EVERY_N=50                                     # Flush Langfuse trace buffer every N classified messages

# Langfuse
LANGFUSE_PUBLIC_KEY=                                          # Langfuse project public key
LANGFUSE_SECRET_KEY=                                          # Langfuse project secret key
LANGFUSE_HOST=https://cloud.langfuse.com                      # Langfuse host (cloud or self-hosted URL)

# Warehouse backend
WAREHOUSE_BACKEND=duckdb                                      # duckdb (local file, no account) or snowflake
DUCKDB_PATH=data/civic_311.duckdb                             # Local warehouse file, relative to the repo root
CLASSIFIER_MODE=live                                          # live (calls Claude) or replay (recorded labels from data/fixtures/, no key)

# Snowflake (only when WAREHOUSE_BACKEND=snowflake)
SNOWFLAKE_ACCOUNT=                                            # Snowflake account locator (e.g., abc12345.us-east-1)
SNOWFLAKE_USER=                                               # Snowflake username
SNOWFLAKE_PASSWORD=                                           # Snowflake password
SNOWFLAKE_DATABASE=CIVIC_311                                  # Target Snowflake database
SNOWFLAKE_SCHEMA=RAW                                          # Target Snowflake schema
SNOWFLAKE_WAREHOUSE=COMPUTE_WH                                # Snowflake warehouse for writes
SNOWFLAKE_ROLE=SYSADMIN                                       # Snowflake role used by the writer

# dbt (profiles.yml target: local = DuckDB, snowflake = Snowflake)
DBT_TARGET=local                                              # local or snowflake
DBT_SNOWFLAKE_ACCOUNT=${SNOWFLAKE_ACCOUNT}                    # dbt Snowflake account
DBT_SNOWFLAKE_USER=${SNOWFLAKE_USER}                          # dbt Snowflake user
DBT_SNOWFLAKE_PASSWORD=${SNOWFLAKE_PASSWORD}                  # dbt Snowflake password
